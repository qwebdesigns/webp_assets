{
  "name": "bundle-viewer",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Static browser viewer for Unity AssetBundles (UnityFS) — parses and decodes entirely client-side.",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "predev": "texture2ddecoder-copy-wasm public/wasm",
    "dev": "vite",
    "prebuild": "texture2ddecoder-copy-wasm public/wasm",
    "build": "vite build",
    "preview": "vite preview",
    "pack": "npm run build && node scripts/pack-host.mjs",
    "samples": "node scripts/fetch-samples.mjs"
  },
  "dependencies": {
    "fflate": "^0.8.3",
    "unity-asset-reader": "^1.3.0",
    "unity-asset-reader-texture": "^1.3.0",
    "texture2ddecoder-wasm": "^1.2.6"
  },
  "devDependencies": {
    "vite": "^6.3.5"
  }
}
